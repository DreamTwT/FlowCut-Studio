{
  "name": "flowcut-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "FlowCut Pro v2.1.0 - Short-Video Batch Mixing & Ad Production Studio",
  "author": "FlowCut Studio",
  "config": {
    "electron_mirror": "https://cdn.npmmirror.com/binaries/electron/",
    "electron_builder_binaries_mirror": "https://cdn.npmmirror.com/binaries/electron-builder-binaries/"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=runtime/server.cjs --external:vite --external:sharp --external:ffmpeg-static --external:ffprobe-static --external:bufferutil --external:utf-8-validate",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production node runtime/server.cjs",
    "prod": "NODE_ENV=production node runtime/server.cjs",
    "desktop": "node desktop/bootstrap-desktop.cjs",
    "dist:win": "node scripts/dist-desktop.cjs --win",
    "dist:mac": "node scripts/dist-desktop.cjs --mac",
    "seed": "tsx server/seedDemo.ts"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "electron-builder": "^25.1.8",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "msedge-tts": "^2.1.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "uuid": "^11.0.5",
    "vite": "^6.2.0"
  }
}
